      "name": "Message a model",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "googlePalmApi": {
          "id": "3OGMkMnam3WQa10b",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Pega a resposta da IA e remove marcações extras\nconst texto = $input.first().json.content.parts[0].text\n  .replace(/```json|```/g, '')\n  .trim();\n\nlet respostas = [];\n\ntry {\n  // Plano A: ler a lista inteira de uma vez\n  respostas = JSON.parse(texto);\n} catch (erro) {\n  // Plano B: ler cada avaliação separadamente, aproveitando as que estiverem certas\n  const pedacos = texto.match(/\\{[^{}]*\\}/g) || [];\n  for (const pedaco of pedacos) {\n    try {\n      respostas.push(JSON.parse(pedaco));\n    } catch (e) {\n      // esta avaliação veio com defeito; será marcada abaixo\n    }\n  }\n}\n\nconst resultado = respostas.map(r => ({\n  json: {\n    id: Number(r.id),\n    sentimento: r.sentimento,\n    tema: r.tema,\n    urgencia: r.urgencia,\n    resumo: r.resumo,\n  },\n}));\n\n// Marca para revisar as avaliações do lote que ficaram sem resposta válida\nconst idsCertos = new Set(resultado.map(r => r.json.id));\nfor (const item of $('Loop Over Items').all()) {\n  if (!idsCertos.has(Number(item.json.id))) {\n    resultado.push({\n      json: { id: item.json.id, sentimento: '', tema: 'ERRO - revisar', urgencia: '', resumo: '' },\n    });\n  }\n}\n\nreturn resultado;"
      },
